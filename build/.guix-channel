;;
;; Guix channel definition for Consent-Aware Web
;;
;; To use this channel, add to ~/.config/guix/channels.scm:
;;
;;   (channel
;;     (name 'Consent-Aware Web)
;;     (url "https://github.com/metadatastician/Consent-Aware Web")
;;     (branch "main"))
;;
;; Then: guix pull

(channel
  (version 0)
  (url "https://github.com/metadatastician/Consent-Aware Web")
  (dependencies
   (channel
     (name 'guix)
     (url "https://git.savannah.gnu.org/git/guix.git")
     (branch "master"))))
