#
# debt.a2ml — Meander debt list
# Things found but not fixed. Carried between sessions.
# Becomes the next session's Phase 0 input.
#
# Reference: ADR-002 in standards/agentic-a2ml/docs/
#
# Each item: category, component, issue, effort (easy|medium|hard),
#            impact (high|medium|low), discovered (ISO date).
# Categories: licence | docs | code | proof | cicd | spec | upstream
#
# Items are consumed (removed) when fixed. Human-readable companion:
# docs/status/DEBT.adoc — keep the two in step.
#
# Baseline established 2026-08-07 at extraction from hyperpolymath/standards.
# Everything below was found by inspection or by a gate, not assumed.

[metadata]
version = "1.0.0"
last-updated = "2026-08-07"
baseline = "extraction from hyperpolymath/standards, 2026-08-07"

# ============================================================================
# SHOULD — would fix next wave
# ============================================================================

[[debt.should]]
category = "spec"
component = "drafts/"
issue = "Author identity differs between the two drafts: draft-jewell-aibdp-00 names 'J. D. A. Jewell' / 'NUJ Ethics Council' / j.d.a.jewell@open.ac.uk; draft-jewell-http-430-consent-required-00 names 'Jonathan D.A. Jewell' / 'National Union of Journalists' / jonathan@metadatastician.art. Different bodies; normatively visible in a published I-D. Owner decision, not an agent's."
effort = "easy"
impact = "high"
discovered = "2026-08-07"

[[debt.should]]
category = "spec"
component = "drafts/"
issue = "Both drafts are -00 and have never been submitted to the IETF datatracker. Until submission there is no external review, no working-group feedback, and no claim to being a standard in progress."
effort = "medium"
impact = "high"
discovered = "2026-08-07"

[[debt.should]]
category = "spec"
component = "draft-jewell-aibdp-00.xml"
issue = "Policy resolution order (policies[purpose] -> scope -> exceptions) is specified only in the reference implementation and in prose. It is not normative text. Two implementations can disagree about exception precedence and both claim conformance."
effort = "medium"
impact = "high"
discovered = "2026-08-07"

[[debt.should]]
category = "spec"
component = "draft-jewell-aibdp-00.xml"
issue = "Unanswered: can an `exceptions` entry GRANT a permission the enclosing policy refuses, or only narrow it? A manifest whose plain reading and machine reading differ is the failure mode this protocol exists to prevent. See PROOF-NEEDS.adoc INV."
effort = "medium"
impact = "high"
discovered = "2026-08-07"

[[debt.should]]
category = "cicd"
component = ".github/workflows/spec-gates.yml"
issue = "draft-structure validates structure only. No rendering validation, because xml2rfc is Python-only and the estate language policy denies Python. Options: IETF external-standards carve-out (precedent at standards/.machine_readable/licensing-policy.toml:61 for this very project), the author-tools.ietf.org API, or accepting an unrendered build. The gate states its own limit rather than implying full validation."
effort = "medium"
impact = "high"
discovered = "2026-08-07"

[[debt.should]]
category = "code"
component = "examples/reference-implementations/aibdp_middleware.js"
issue = "No unit tests. pathMatches, getApplicablePolicy, extractAiPurpose and checkPolicyConditions are exercised only end-to-end through five HTTP requests. Glob semantics (/docs/**, ?) and exception precedence are untested at the unit level — and glob semantics are themselves unspecified."
effort = "easy"
impact = "high"
discovered = "2026-08-07"

[[debt.should]]
category = "code"
component = "tests/"
issue = "The five invalid manifests used to prove validate-manifests.ts can fail were built ad hoc during development and discarded. Without a committed negative corpus the proof is anecdotal, not repeatable."
effort = "easy"
impact = "medium"
discovered = "2026-08-07"

[[debt.should]]
category = "code"
component = "examples/manifest-scenarios/"
issue = "41 KB of worked manifest scenarios exist only as prose inside README.md. There are no .json files, so no gate validates any of them. Scenarios that cannot be validated will drift from the schema silently — the same class of failure as the demo manifest whose scope paths did not match its own server."
effort = "medium"
impact = "high"
discovered = "2026-08-07"

[[debt.should]]
category = "licence"
component = "tree-wide"
issue = "Four licences coexist: CC-BY-SA-4.0 (125 files), MPL-2.0 (111), MIT OR GPL-3.0-or-later (6, the reference implementations), CC-BY-4.0 (2, carried from standards). The MIT/GPL choice is deliberate — IETF submission requires it, recorded in standards/.machine_readable/licensing-policy.toml:61 — but the root LICENSE does not mention the carve-out, so the tree does not explain itself. NOTE: licence files are owner-managed; no automated edits, ever."
effort = "easy"
impact = "medium"
discovered = "2026-08-07"

[[debt.should]]
category = "licence"
component = "standards/.machine_readable/licensing-policy.toml"
issue = "The MIT external-standards carve-out and the prospective-PMPL entry both name this project by its OLD path (consent-aware-http, a directory inside standards). After extraction and rename they point at nothing. Owner-only to amend."
effort = "easy"
impact = "medium"
discovered = "2026-08-07"

[[debt.should]]
category = "docs"
component = "docs/status/SCOPE.adoc"
issue = "Marked Definitive and scopes the suite to HTTP 430 + AIBDP, but the repository is now named consent-aware-web and README presents a six-layer architecture. Either SCOPE widens or the name narrows. Currently README marks four layers 'not drafted', which is honest but leaves the two documents saying different things about what this project is."
effort = "easy"
impact = "high"
discovered = "2026-08-07"

[[debt.should]]
category = "cicd"
component = ".github/settings.yml"
issue = "contexts = [] — no required status checks. Every gate is advisory until pinned. Pinning must wait until each job has run green once and the exact context string has been read from the check-runs API; a context that never reports blocks the branch permanently."
effort = "easy"
impact = "high"
discovered = "2026-08-07"

[[debt.should]]
category = "cicd"
component = ".github/workflows/sonarqube.yml"
issue = "SONAR_TOKEN is not set (the repository has no Actions secrets) and it is unconfirmed whether a SonarCloud organisation 'metadatastician' exists. The job will fail until both are resolved. Failing loudly is correct; leaving it unexplained is the debt."
effort = "easy"
impact = "medium"
discovered = "2026-08-07"

[[debt.should]]
category = "upstream"
component = "hyperpolymath/standards"
issue = "LANGUAGE-POLICY.adoc section 1 rules Bun > Deno > pnpm > npm, but governance-reusable.yml:490 still fails builds carrying bun.lockb with 'Use Deno instead', docs/JS-RUNTIME-POLICY.adoc:79 states the exact inverse ordering, and .claude/CLAUDE.md:115 instructs agents to migrate Bun to Deno. governance-reusable is called estate-wide, so the ruling is recorded but not in force. This repository's validator is dependency-free specifically to avoid tripping it."
effort = "medium"
impact = "high"
discovered = "2026-08-07"

[[debt.should]]
category = "upstream"
component = "hyperpolymath/rsr-template-repo"
issue = ".cursorrules, .clinerules, .windsurfrules and .github/copilot-instructions.md all instruct agents 'TypeScript -> use ReScript' and 'Node.js / npm / bun -> use Deno'. LANGUAGE-POLICY section 1.2 retired the ReScript rule because ReScript is no longer used in this estate. These files propagate to every mint, so every new repository is born instructing agents toward a dead language and the second-choice runtime. Corrected wording exists in this repository and can be lifted verbatim."
effort = "easy"
impact = "high"
discovered = "2026-08-07"

[[debt.should]]
category = "upstream"
component = "hyperpolymath/rsr-template-repo build/just/repo-init.just"
issue = "Line 305 still excludes './build/just/init.just', a path deleted in the 2026-08-02 init->repo-init rename. Unpatched, the self-name pass rewrites the minted repo's own PARENT_SLUG (uppercase PARENT evades the case-sensitive provenance guard) and inverts its 'if REPO != rsr-template-repo' guard. One-line fix; not covered by open PR #16. Patched locally before minting this repository."
effort = "easy"
impact = "high"
discovered = "2026-08-07"

[[debt.should]]
category = "upstream"
component = "hyperpolymath/rsr-template-repo build/just/repo-init.just"
issue = "RSR_NON_INTERACTIVE=1 is unusable. The read() stub at line 20 also captures the two 'while read -r file' substitution loops, so under set -u the recipe aborts with 'file: unbound variable' having substituted nothing, and without it loops forever. Mint via piped stdin instead."
effort = "medium"
impact = "medium"
discovered = "2026-08-07"

[[debt.should]]
category = "upstream"
component = "hyperpolymath/rsr-template-repo scripts/check-no-placeholders.sh"
issue = "Dies silently in a repository that has no origin remote. Under 'set -euo pipefail' the line REPO_NAME=$(git config --get remote.origin.url | sed ...) exits 1 when no remote is configured, killing the script before it prints anything. Exit 1 with no output reads as 'the check found placeholders' when in fact the check never ran. The failure window is exactly the freshly minted repo before its first push. Verified 2026-08-07: adding a remote makes it PASS, removing it restores the silent exit 1. Fix: tolerate the missing remote (|| true) and fall back to the directory name."
effort = "easy"
impact = "high"
discovered = "2026-08-07"

[[debt.should]]
category = "upstream"
component = "metadatastician org Actions policy"
issue = "The organisation Actions allowlist (allowed_actions=selected, sha_pinning_required=true) has patterns_allowed containing 'denoland/*' but NOT 'oven-sh/*'. Any workflow referencing oven-sh/setup-bun is rejected with startup_failure, zero jobs and no explanatory log. This is the estate Bun ruling contradicting itself in a THIRD place, after governance-reusable.yml and the AI instruction files: the policy permits the Deno setup action and forbids the Bun one while LANGUAGE-POLICY.adoc section 1 makes Bun tier 1. Cannot be fixed per-repo (409 Conflict: 'already set at the organization or enterprise level'); needs an org admin. Worked around here with a local composite action at .github/actions/setup-bun that installs a pinned, checksum-verified Bun — which satisfies the policy rather than evading it, but every other repo adopting Bun will hit the same wall."
effort = "easy"
impact = "high"
discovered = "2026-08-07"

[[debt.should]]
category = "cicd"
component = "governance-reusable.yml 'Check SHA-pinned actions' vs .github/workflows/actions.lock"
issue = "Two incompatible pinning models collide, and this repository fails both Governance and Workflow Security Linter because of it. The RSR template pins via actions.lock (tag refs in workflows, SHAs in the lockfile); the standards linter demands inline SHAs in the workflow files. Satisfying the linter naively is known to be WORSE — inline SHAs remove actions from lockfile coverage, measured at 14 startup_failures in a single commit elsewhere in the estate. Six inherited template workflows are flagged (static-analysis-gate, dependabot-automerge, quality, rhodibot, estate-rules, workflow-linter), none of them authored here. Two further hits are false positives: the linter greps for 'uses:' and matches the dependencies section INSIDE actions.lock itself (lines 55 and 102). Needs an estate ruling on which model is canonical, not a per-repo fix."
effort = "hard"
impact = "high"
discovered = "2026-08-07"

[[debt.should]]
category = "cicd"
component = ".github/dependabot.yml + actions.lock"
issue = "Dependabot bumped github/codeql-action to v4.37.6 in codeql.yml on the first day but did not update actions.lock, which still said v4.37.4. The mismatch made CodeQL Security Analysis startup_failure. Dependabot has no awareness of the lockfile, so every future action bump reintroduces this. Either dependabot must be taught to update actions.lock, or a gate must fail when workflow refs and lockfile entries disagree."
effort = "medium"
impact = "high"
discovered = "2026-08-07"

[[debt.should]]
category = "upstream"
component = "hyperpolymath/rsr-template-repo .github/workflows/codeql.yml"
issue = "The template ships an advanced CodeQL workflow, but GitHub's default CodeQL setup is enabled on new metadatastician repositories. When default setup is configured, an advanced CodeQL workflow is rejected outright: startup_failure, every push, forever. Measured here 2026-08-07 — default setup covers actions/javascript/javascript-typescript/typescript and was already producing results (103 and 23 rules) while the advanced workflow, whose matrix is 'actions' ONLY, could not start. The template's workflow is therefore both non-running and narrower than what runs anyway. Removed from this repository. The template should either drop it or document that default setup must be disabled first."
effort = "easy"
impact = "high"
discovered = "2026-08-07"

