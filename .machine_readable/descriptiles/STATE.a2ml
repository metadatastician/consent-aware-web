#
# STATE.a2ml — Project state checkpoint
#
# Rewritten wholesale at extraction (2026-08-07). The minted file inherited the
# RSR template's own body — purpose "canonical repository template", 95%
# complete, phase maintenance, maturity production, and nine milestones about
# container scaffolding. The template warns about exactly this in its own
# trailing comment; `just repo-init` does not act on the warning.

[metadata]
project = "consent-aware-web"
version = "0.2.0"
last-updated = "2026-08-07"
status = "active"  # active | paused | archived

[project-context]
name = "consent-aware-web"
purpose = "IETF-track specifications for consent-aware HTTP: the AI Boundary Declaration Protocol (AIBDP), a machine-readable manifest at /.well-known/aibdp.json declaring permitted and prohibited AI uses, and HTTP status code 430 (Consent Required) as its enforcement mechanism."
completion-percentage = 30

[position]
phase = "design"           # design | implementation | testing | maintenance | archived
maturity = "experimental"  # experimental | alpha | beta | production | lts

# Both drafts are -00 and have never been submitted to the IETF datatracker.
# "design" and "experimental" are the honest readings; an unsubmitted -00 is not
# a production standard however complete the surrounding repository looks.

[route-to-mvp]
milestones = [
  { name = "Two Internet-Drafts, well-formed RFC-XML v3", completion = 100 },
  { name = "AIBDP JSON Schema (draft-2020-12)", completion = 100 },
  { name = "Reference implementation, enforcement verified end-to-end", completion = 100 },
  { name = "Self-hosted AIBDP manifest (repo dogfoods its own protocol)", completion = 100 },
  { name = "Documentation set in AsciiDoc, validating clean", completion = 100 },
  { name = "CI gates that can genuinely fail (draft-validate, single-source, schema-validate, claims-audit, draft-expiry)", completion = 0 },
  { name = "IETF datatracker submission of both -00 drafts", completion = 0 },
  { name = "Conformance test suite for AIBDP manifest processors", completion = 0 },
  { name = "A second, independent, interoperating implementation", completion = 0 },
]

[blockers-and-issues]
blockers = [
  "RESOLVED 2026-08-07: author identity ruled by the owner as j.d.a.jewell@open.ac.uk; both drafts now carry an identical author block. One mailbox confirms both submissions.",
  "Draft validation toolchain undecided. xml2rfc is Python-only, which the estate language policy denies; options are an IETF external-standards carve-out (precedent exists in standards/.machine_readable/licensing-policy.toml for this project), the author-tools.ietf.org API, or accepting an unvalidated build.",
  "Repository name (consent-aware-web) claims broader scope than the two drafts deliver. docs/status/SCOPE.adoc is marked Definitive and still scopes the suite to HTTP 430 + AIBDP.",
]

[critical-next-actions]
actions = [
  "Wire the five spec gates and confirm each can fail (see route-to-mvp).",
  "Resolve the author organization, then submit both -00 drafts to the datatracker.",
  "Decide the xml2rfc question; until then draft-validate cannot run.",
  "Reconcile SCOPE.adoc with the repository name, or rename back.",
  "Refresh drafts before expiresDate 2027-02-08 — draft-expiry will go red on that date by design.",
]

[maintenance-status]
last-run-utc = "never"
last-report = "docs/reports/maintenance/latest.json"
last-result = "unknown"  # unknown | pass | warn | fail
open-warnings = 0
open-failures = 0

[ecosystem]
part-of = ["RSR Framework"]
depends-on = []
# No runtime dependencies. This is a specification suite: the deliverables are
# documents and a JSON Schema. The reference implementations depend only on
# their runtime (Bun tier 1, Deno tier 2) and node:fs.
