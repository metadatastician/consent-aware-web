# SPDX-License-Identifier: MPL-2.0
# ECOSYSTEM.a2ml — Ecosystem position
#
# Rewritten wholesale at extraction (2026-08-07). The minted file inherited the
# RSR template's own ecosystem position — type "repository-template", a chain of
# "standards → rsr-template-repo → (every estate repo)", and seven related
# projects describing container tooling this repository does not use. The
# template flags this in a trailing NOTE FOR CONSUMERS; `just repo-init` does
# not act on it, and the `chain =` line is additionally protected from the
# self-name pass by the provenance guard, so nothing rewrites it.

[metadata]
project = "consent-aware-web"
ecosystem = "hyperpolymath"

[position]
type = "specification"
purpose = "IETF-track specification suite for consent-aware AI interaction with the web: AIBDP (a machine-readable manifest at /.well-known/aibdp.json declaring permitted and prohibited AI uses) and HTTP 430 (Consent Required) as its enforcement mechanism."

# IS-NOT — anti-identity (the boundary-erosion guard; each line is a real past confusion)
what-this-is-not = [
  "an AI blocker — the protocol declares boundaries, it does not prohibit AI (see docs/explainer.adoc)",
  "a replacement for robots.txt — robots.txt governs crawling and indexing; AIBDP governs AI-specific use",
  "AVOW — that is application-layer anti-spam consent with cryptographic tokens; this is transport-layer signalling with no crypto",
  "an authentication or authorisation protocol — it is not OAuth, OIDC or WebAuthn",
  "a cookie-consent or GDPR-banner library",
  "a browser UI specification",
  "a running service — the deliverables are documents and a JSON Schema",
]

[pipeline]
position = "specification-source"
chain = "consent-aware-web → (AIBDP manifest publishers) → (AI systems honouring 430)"
notes = "The deliverables are two Internet-Drafts and a JSON Schema. Origins publish an AIBDP manifest and return 430 when a declared boundary is unmet; AI systems read the manifest and honour it. The reference implementations in examples/ demonstrate the origin side."
coordination = "standards"

[related-projects]
projects = [
  { name = "standards", relationship = "canon-source", notes = "Extracted from standards/consent-aware-http/ on 2026-08-07. Retains the registry entry, the licence carve-outs (PMPL prospective; MIT for IETF-submitted files) and the ietf-draft-names-frozen invariant." },
  { name = "AVOW", relationship = "complementary", notes = "Deliberately non-overlapping. AVOW is application-layer anti-spam consent using cryptographic tokens; this suite is transport-layer signalling with no cryptography. Recorded in docs/status/SCOPE.adoc." },
  { name = "rsr-template-repo", relationship = "template-parent", notes = "Minted from pin c250e661. Provenance in descriptiles/VARIANT.a2ml; drift checked by scripts/check-variant-drift.sh." },
]

[external-standards]
builds-on = [
  { name = "RFC 9110", notes = "HTTP Semantics — 430 extends the 4xx space; §15.5.3 is cited normatively." },
  { name = "RFC 9309", notes = "Robots Exclusion Protocol — AIBDP complements rather than replaces it." },
  { name = "RFC 8615", notes = "Well-Known URIs — defines the /.well-known/ path AIBDP occupies." },
  { name = "RFC 7725", notes = "HTTP 451 — cited to distinguish legal unavailability from consent failure." },
]
