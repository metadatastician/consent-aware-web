# SPDX-License-Identifier: MPL-2.0
#
# rsr-profile.a2ml — this repo's declared RSR v2.0 capabilities.
# Generated by just repo-init on 2026-08-07. The template's maximal
# profile was removed at mint: declare only what this tree carries.

[rsr-profile]
version = "1.0.0"
spec = "rsr-criteria-v2"
declares-against = "2.0.0-draft"
# Deliberately empty, and this is the honest declaration rather than an
# unfilled one. This repository is a specification suite: it has no build
# artefact, no test binary, no proof obligations and no container. Declaring a
# capability it does not have would make the RSR oracle score absent modules —
# the na-honesty failure. Capabilities are declared here when they become real.
# Reference: standards/.machine_readable/template-capability-gates.toml
capabilities = []
